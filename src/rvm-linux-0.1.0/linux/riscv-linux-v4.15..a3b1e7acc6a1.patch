 #include <asm/setup.h>
 #include <asm/sections.h>
@@ -207,6 +208,8 @@ void __init setup_arch(char **cmdline_p)
 	paging_init();
 	unflatten_device_tree();
 
+	swiotlb_init(1);
+
 #ifdef CONFIG_SMP
 	setup_smp();
 #endif
