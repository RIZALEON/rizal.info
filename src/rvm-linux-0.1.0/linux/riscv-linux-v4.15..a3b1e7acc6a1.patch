@@ -0,0 +1,1051 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * SiFive UART driver
+ * Copyright (C) 2018 Paul Walmsley <paul@pwsan.com>
+ *
+ * Based partially on drivers/tty/serial/pxa.c, drivers/pwm/pwm-sifive.c,
